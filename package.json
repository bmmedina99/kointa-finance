{
  "name": "kointa-finance",
  "description": "Aplicación web para la gestión de finanzas personales, diseñada para ayudar a las personas a llevar un control claro y visual de sus ingresos, gastos y categorías.",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack --port 4000",
    "build": "next build",
    "start": "next start --port 5000",
    "release": "pnpm dlx semantic-release",
    "fmt": "pnpm biome format --write .",
    "lint": "pnpm biome lint --write ."
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/bmmedina99/kointa-finance.git"
  },
  "dependencies": {
    "next": "15.5.4",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.13",
    "@semantic-release/changelog": "6.0.3",
    "@semantic-release/git": "10.0.1",
    "@tailwindcss/postcss": "4.2.4",
    "@types/node": "25.6.0",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "tailwindcss": "4.2.4",
    "typescript": "6.0.3"
  },
  "packageManager": "pnpm@10.33.2"
}
